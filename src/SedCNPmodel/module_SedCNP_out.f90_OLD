!                 WSo_RPON = WSo_RPON + So_RPON(i,j,isl)
!                 WSo_LDON = WSo_LDON + So_LDON(i,j,isl)
!                 WSo_RDON = WSo_RDON + So_RDON(i,j,isl)
!                 WSo_MBMN = WSo_MBMN + So_MBMN(i,j,isl)
!                 WSo_NH4 = WSo_NH4 + So_NH4(i,j,isl)
!                 WSo_NO3 = WSo_NO3 + So_NO3(i,j,isl)
!                 WSo_NSC = WSo_NSC + So_NSC(i,j,isl)
!                 WSo_NMBError = WSo_NMBError + So_NMBError(i,j,isl)  !BK20240502
!              END DO
!           endif
!        END DO
!     END DO
