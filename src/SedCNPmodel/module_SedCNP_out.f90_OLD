!
!     smonth = trim(dateSedCNP%olddate(6:7))  !BK20240117
!     read(smonth,*) imonth                   !BK20240117
!
!     outdir = trim(SedCNPmodel%WHQOUT_dir)  !BK20240102
!     dt = real(SedCNPmodel%SedCNP_timestep)   !BK20231016
!     
!     !> For the whole WATERSHED
!     !* at the end of each time-step, update cumulative variables for the whole
!     !  watershed and write output files:
!
!     ! --- SOIL
!     !WSo_LPONLITinso = 0.
