!              WAq_NH4aqso0 = WAq_NH4aqso0 + Aq_NH4aqso0(i,j)
!              WAq_NO3aqso0 = WAq_NO3aqso0 + Aq_NO3aqso0(i,j)
!              WSo_LPONsurf = WSo_LPONsurf + So_LPONsurf(i,j)
!              WSo_RPONsurf = WSo_RPONsurf + So_RPONsurf(i,j)
!              WSo_MBMNsurf = WSo_MBMNsurf + So_MBMNsurf(i,j)
