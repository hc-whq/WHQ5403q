!  subroutine write_C_output(itime)  !BK
!
!     !to write C outputs in time series data format   !#BK
!
!     use module_SedCNPvariables    !#BK
!
!     implicit none
!     integer  :: lcover         !land code (Y.Kwon)   !BK20231005
!     ! real    :: lcover         !land code (Y.Kwon)
!     integer :: i,j,itime, isl, ia      !Y.Kwon  !BK20240512
!     !integer :: ibasin, sbid  !BK20240512
!     integer :: ich, chid     !BK20240512
!     integer :: gwid     !BK20240613
!     real(8)            :: dt     !BK20231016
!     character(len=256)  :: outdir  !BK20240102
!     character(len=256)  :: filename  !BK20240102
!     character(len=2) :: smonth              !BK20240117
!     integer :: imonth                       !BK20240117
!
!     smonth = trim(dateSedCNP%olddate(6:7))  !BK20240117
!     read(smonth,*) imonth                   !BK20240117
!
!     outdir = trim(SedCNPmodel%WHQOUT_dir)  !BK20240102
!     dt = real(SedCNPmodel%SedCNP_timestep)   !BK20231016
!     
!     !> For the whole WATERSHED
!     !* at the end of each time-step, update cumulative variables for the whole
!     !  watershed and write output files:
!
!     ! --- SOIL  !#BK
!     !WSo_LPOCLITinso = 0.
!     !WSo_LPOCRESinso = 0.
!     !WSo_LPOCEXCinso = 0.
!     !WSo_LPOCMANinso = 0.
!     WSo_LPOCLITin = 0.  !BK20240630
!     WSo_LPOCRESin = 0.  !BK20240630
!     WSo_LPOCEXCin = 0.  !BK20240630
!     WSo_LPOCMANin = 0.  !BK20240630
!     WAq_LDOCaqso0 = 0.
!     WAq_RDOCaqso0 = 0.
!     WSo_LPOCsurf = 0.
!     WSo_RPOCsurf = 0.
!     WSo_MBMCsurf = 0.
!     WSo_LDOCsurf = 0.
!     WSo_RDOCsurf = 0.
!     WSo_LDOCintf = 0.
!     WSo_RDOCintf = 0.
!     WSo_LDOCsoaq = 0.
!     WSo_RDOCsoaq = 0.
!     WSo_LPOCLIT = 0.
!     WSo_LPOCRES = 0.
!     WSo_LPOCEXC = 0.
!     WSo_LPOCMAN = 0.
!     WSo_RPOC = 0.
!     WSo_LDOC = 0.
!     WSo_RDOC = 0.
!     WSo_MBMC = 0.
!     WSo_CO2 = 0.
!     WSo_CSC = 0.
!     WSo_CMBError = 0.   !BK20240502
!
!     DO i = 1, domain%ix 
!        DO j = 1, domain%jx 
!           !lcover = SedCNP_hydro%vgtyp(i,j)           ! vegetation type  !Y.Kwon  
!           lcover = int(SedCNP_hydro%vgtyp(i,j))           ! vegetation type  !Y.Kwon  !BK20231006 !BK20240205
!
!           if(lcover.gt.0.) then   !Y.Kwon 
!              !WSo_LPOCLITinso = WSo_LPOCLITinso + So_LPOCLITinso(lcover,itime)    !Y.Kwon
!              !WSo_LPOCRESinso = WSo_LPOCRESinso + So_LPOCRESinso(lcover,itime)    !Y.Kwon
!              !WSo_LPOCEXCinso = WSo_LPOCEXCinso + So_LPOCEXCinso(lcover,itime)    !Y.Kwon
!              !WSo_LPOCMANinso = WSo_LPOCMANinso + So_LPOCMANinso(lcover,itime)    !Y.Kwon
!              !WSo_LPOCLITnso = WSo_LPOCLITinso + So_LPOCLITinso(lcover,imonth) * dt    !BK20240117
!              !WSo_LPOCRESinso = WSo_LPOCRESinso + So_LPOCRESinso(lcover,imonth) * dt    !BK20240117
!              !WSo_LPOCEXCinso = WSo_LPOCEXCinso + So_LPOCEXCinso(lcover,imonth) * dt    !BK20240117
!              !WSo_LPOCMANinso = WSo_LPOCMANinso + So_LPOCMANinso(lcover,imonth) * dt    !BK20240117
!              WSo_LPOCLITin = WSo_LPOCLITin + So_LPOCLITin(i,j)    !BK20240630
!              WSo_LPOCRESin = WSo_LPOCRESin + sum(So_LPOCRESin(i,j,1:domain%nsl))    !BK20240630
!              WSo_LPOCEXCin = WSo_LPOCEXCin + So_LPOCEXCin(i,j)    !BK20240630
!              WSo_LPOCMANin = WSo_LPOCMANin + So_LPOCMANin(i,j)    !BK20240630
!              WAq_LDOCaqso0 =  WAq_LDOCaqso0 +  Aq_LDOCaqso0(i,j)
!              WAq_RDOCaqso0 = WAq_RDOCaqso0 + Aq_RDOCaqso0(i,j)
!              WSo_LPOCsurf = WSo_LPOCsurf + So_LPOCsurf(i,j)
