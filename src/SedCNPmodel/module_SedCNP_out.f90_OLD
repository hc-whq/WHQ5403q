!     !WSo_LPONMANinso = 0.
!     !WSo_NH4fert = 0.
!     !WSo_NO3fert = 0.
!     WSo_LPONLITin = 0.  !BK20240630
!     WSo_LPONRESin = 0.  !BK20240630
!     WSo_LPONEXCin = 0.  !BK20240630
!     WSo_LPONMANin = 0.  !BK20240630
!     WSo_NH4fxin = 0.  !BK20240630
!     WSo_NO3fxin = 0.  !BK20240630
!     WAq_LDONaqso0 = 0.
!     WAq_RDONaqso0 = 0.
!     WAq_NH4aqso0 = 0.
!     WAq_NO3aqso0 = 0.
!     WSo_LPONsurf = 0.
!     WSo_RPONsurf = 0.
!     WSo_MBMNsurf = 0.
!     WSo_LDONsurf = 0.
!     WSo_RDONsurf = 0.
!     WSo_NH4surf = 0.
