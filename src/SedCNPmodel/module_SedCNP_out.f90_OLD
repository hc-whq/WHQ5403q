!     WSo_LPONRES = 0.
!     WSo_LPONEXC = 0.
!     WSo_LPONMAN = 0.
!     WSo_RPON = 0.
!     WSo_LDON = 0.
!     WSo_RDON = 0.
!     WSo_MBMN = 0.
!     WSo_NH4 = 0.
!     WSo_NO3 = 0.
!     WSo_NSC = 0.
!     WSo_NMBError = 0.  !BK20240502
!
!     DO i = 1, domain%ix 
!        DO j = 1, domain%jx
!           !lcover = SedCNP_hydro%vgtyp(i,j)           ! vegetation type  !Y.Kwon
!           lcover = int(SedCNP_hydro%vgtyp(i,j))           ! vegetation type  !Y.Kwon  !BK20231006 !BK20240205
!
!           if(lcover.gt.0.) then  !BK20240205 
