  subroutine write_Aq_N_output(output_flnm)

     use module_SedCNPvariables
     use module_NWM_io_dict

     implicit none

     integer, parameter                         :: numAqNVars   = 18
     character (len=64), dimension(numAqNVars)  :: AqNOut_varNames
     character (len=64), dimension(numAqNVars)  :: AqNOut_longName  ! Long names for each variable.
     character (len=64), dimension(numAqNVars)  :: AqNOut_units     ! Units for each variable.
     character(len=256)                         :: output_flnm       ! CNPOUT_DOMAIN filename
     integer                                    :: diagFlag
     integer                                    :: ftn, ftnAqN      ! NetCDF file handle
     integer                                    :: iret              ! NetCDF return statuses
     integer                                    :: iTmp
     integer                                    :: varId             ! Variable ID value created as NetCDF variables are created and populated.
     integer                                    :: dimId(4)         ! Dimension ID values created during NetCDF created.

     AqNOut_varNames(:) = [character(len=64) :: &
                          "So_LDONsoaq0","So_RDONsoaq0","So_NH4soaq0","So_NO3soaq0","Aq_LDONaqso",& !1-5
                          "Aq_RDONaqso","Aq_NH4aqso","Aq_NO3aqso","Aq_LDONaqgw","Aq_RDONaqgw",&     !6-10
                          "Aq_NH4aqgw","Aq_NO3aqgw","Aq_LDON","Aq_RDON","Aq_NH4",&                  !11-15
                          "Aq_NO3","Aq_NSC","Aq_NMBError"]                                          !16-18
     AqNOut_longName(:) = [character(len=128) :: &
                          "So_LDONsoaq0","So_RDONsoaq0","So_NH4soaq0","So_NO3soaq0","Aq_LDONaqso",& !1-5
                          "Aq_RDONaqso","Aq_NH4aqso","Aq_NO3aqso","Aq_LDONaqgw","Aq_RDONaqgw",&     !6-10
                          "Aq_NH4aqgw","Aq_NO3aqgw","Aq_LDON","Aq_RDON","Aq_NH4",&                  !11-15
                          "Aq_NO3","Aq_NSC","Aq_NMBError"]                                          !16-18
     AqNOut_units(:) = [character(len=64) :: &
                          "kgN dt-1","kgN dt-1","kgN dt-1","kgN dt-1","kgN dt-1",&                  !1-5
                          "kgN dt-1","kgN dt-1","kgN dt-1","kgN dt-1","kgN dt-1",&                  !6-10
                          "kgN dt-1","kgN dt-1","kgN","kgN","kgN",&                                 !11-15
                          "kgN","kgN dt-1","kgN dt-1"]                                              !16-18

     ! Create output file
     iret = nf90_create(trim(output_flnm),cmode=NF90_NETCDF4,ncid = ftn)
     call nwmCheck(diagFlag,iret,'ERROR: Unable to create AQNOUT NetCDF file.')
     ftnAqN = ftn

     ! Create dimensions
     iret = nf90_def_dim(ftnAqN,'time',NF90_UNLIMITED,dimId(1))
     call nwmCheck(diagFlag,iret,'ERROR: Unable to define time dimension')
     iret = nf90_def_dim(ftnAqN,'x',domain%ix,dimId(2))
     call nwmCheck(diagFlag,iret,'ERROR: Unable to define x dimension')
     iret = nf90_def_dim(ftnAqN,'y',domain%jx,dimId(3))
     call nwmCheck(diagFlag,iret,'ERROR: Unable to define y dimension')

     ! Loop through all possible variables and create them, along with their
     ! metadata attributes.

     !create time variable attributes [minutes since 1970-01-01 00:00:00 UTC]  !Y.Kwon20241125
     iret = nf90_def_var(ftnAqN,"time",nf90_float,(/dimId(1)/),varId)
     call nwmCheck(diagFlag,iret,"ERROR: Unable to create variable: "//"time")
     iret = nf90_put_att(ftnAqN,varId,'long_name','valid output time')
     call nwmCheck(diagFlag,iret,'ERROR: Unable to place long_name attribute into variable '//'time')
     iret = nf90_put_att(ftnAqN,varId,'units','minutes since 1970-01-01 00:00:00 UTC')
     call nwmCheck(diagFlag,iret,'ERROR: Unable to place units attribute into variable '//'time')

     do iTmp=1,numAqNVars
        iret = nf90_def_var(ftnAqN,trim(AqNOut_varNames(iTmp)),nf90_double,(/dimId(2),dimId(3),dimId(1)/),varId)
        call nwmCheck(diagFlag,iret,"ERROR: Unable to create variable: "//trim(AqNOut_varNames(iTmp)))

        ! Create variable attributes
        iret = nf90_put_att(ftnAqN,varId,'long_name',trim(AqNOut_longName(iTmp)))
        call nwmCheck(diagFlag,iret,'ERROR: Unable to place long_name attribute into variable '//trim(AqNOut_varNames(iTmp)))
        iret = nf90_put_att(ftnAqN,varId,'units',trim(AqNOut_units(iTmp)))
        call nwmCheck(diagFlag,iret,'ERROR: Unable to place units attribute into variable '//trim(AqNOut_varNames(iTmp)))
