!
!  subroutine write_N_output(itime)
!
!     !to write N outputs in time series data format
!
!     use module_SedCNPvariables !Y.Kwon
!
!     implicit none
!     integer :: itime, i, j, isl, ia
!     !integer :: ibasin, sbid  !BK20240512
