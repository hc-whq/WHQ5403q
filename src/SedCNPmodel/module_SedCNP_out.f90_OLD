!
!  subroutine write_P_output(itime)
!
!     !to write P outputs in time series data format
!
!     use module_SedCNPvariables    !#BK
!
!     implicit none
!     integer    :: lcover         !land code (Y.Kwon)   !BK20231005
!     ! real    :: lcover         !land code (Y.Kwon)
!     integer :: itime, i, j, isl, ia
!     !integer :: ibasin, sbid  !BK20240513
!     integer :: ich, chid     !BK20240513
!     integer :: gwid     !BK20240613
!     real(8)            :: dt     !BK20231016
!     character(len=256)  :: outdir  !BK20240102
!     character(len=256)  :: filename  !BK20240102
!     character(len=2) :: smonth              !BK20240117
!     integer :: imonth                       !BK20240117
!
!     smonth = trim(dateSedCNP%olddate(6:7))  !BK20240117
!     read(smonth,*) imonth                   !BK20240117
!
!     outdir = trim(SedCNPmodel%WHQOUT_dir)  !BK20240102
!     dt = real(SedCNPmodel%SedCNP_timestep)   !BK20231016
!
!     !> For the whole WATERSHED
!     !* at the end of each time-step, update cumulative variables for the whole
!     !  watershed and write output files:
!
!     ! --- SOIL
!     !WSo_LPOPLITinso = 0.
!     !WSo_LPOPRESinso = 0.
!     !WSo_LPOPEXCinso = 0.
!     !WSo_LPOPMANinso = 0.
!     !WSo_PO4fert = 0.
!     WSo_LPOPLITin = 0.  !BK20240630
!     WSo_LPOPRESin = 0.  !BK20240630
!     WSo_LPOPEXCin = 0.  !BK20240630
!     WSo_LPOPMANin = 0.  !BK20240630
!     WSo_PO4fxin = 0.  !BK20240630
!     WAq_LDOPaqso0 = 0.
!     WAq_RDOPaqso0 = 0.
!     WAq_PO4aqso0 = 0.
!     WSo_LPOPsurf = 0.
!     WSo_RPOPsurf = 0.
!     WSo_MBMPsurf = 0.
!     WSo_LDOPsurf = 0.
!     WSo_RDOPsurf = 0.
!     WSo_PO4surf = 0.
!     WSo_PIPAsurf = 0.
!     WSo_PIPSsurf = 0.
!     WSo_LDOPintf = 0.
!     WSo_RDOPintf = 0.
!     WSo_PO4intf = 0.
!     WSo_LDOPsoaq = 0.
!     WSo_RDOPsoaq = 0.
!     WSo_PO4soaq = 0.
!     WSo_PO4uptk = 0.
!     WSo_LPOPLIT = 0.
!     WSo_LPOPRES = 0.
!     WSo_LPOPEXC = 0.
!     WSo_LPOPMAN = 0.
!     WSo_RPOP = 0.
!     WSo_LDOP = 0.
!     WSo_RDOP = 0.
!     WSo_MBMP = 0.
!     WSo_PO4 = 0.
!     WSo_PIPA = 0.
!     WSo_PIPS = 0.
!     WSo_PSC = 0.
!     WSo_PMBError = 0.  !BK20240502
!
!     DO i = 1, domain%ix 
!        DO j = 1, domain%jx 
!           !lcover = SedCNP_hydro%vgtyp(i,j)           ! vegetation type  !Y.Kwon
!           lcover = int(SedCNP_hydro%vgtyp(i,j))           ! vegetation type  !Y.Kwon  !BK20231006 !BK20240205
!
!           if(lcover.gt.0.) then   !Y.Kwon
!              !WSo_LPOPLITinso = WSo_LPOPLITinso + So_LPOPLITinso(lcover,itime)    !Y.Kwon
!              !WSo_LPOPRESinso = WSo_LPOPRESinso + So_LPOPRESinso(lcover,itime)    !Y.Kwon
!              !WSo_LPOPEXCinso = WSo_LPOPEXCinso + So_LPOPEXCinso(lcover,itime)    !Y.Kwon
!              !WSo_LPOPMANinso = WSo_LPOPMANinso + So_LPOPMANinso(lcover,itime)    !Y.Kwon
!              !WSo_PO4fert = WSo_PO4fert + So_PO4fert(lcover,itime)    !Y.Kwon
!              !WSo_LPOPLITinso = WSo_LPOPLITinso + So_LPOPLITinso(lcover,imonth)*dt    !BK20240117
!              !WSo_LPOPRESinso = WSo_LPOPRESinso + So_LPOPRESinso(lcover,imonth)*dt    !BK20240117
!              !WSo_LPOPEXCinso = WSo_LPOPEXCinso + So_LPOPEXCinso(lcover,imonth)*dt    !BK20240117
!              !WSo_LPOPMANinso = WSo_LPOPMANinso + So_LPOPMANinso(lcover,imonth)*dt    !BK20240117
!              !WSo_PO4fert = WSo_PO4fert + So_PO4fert(lcover,imonth)*dt    !BK20240117
!              
!              WSo_LPOPLITin = WSo_LPOPLITin + So_LPOPLITin(i,j)    !BK20240630
!              WSo_LPOPRESin = WSo_LPOPRESin + sum(So_LPOPRESin(i,j,1:domain%nsl))    !BK20240630
!              WSo_LPOPEXCin = WSo_LPOPEXCin + So_LPOPEXCin(i,j)    !BK20240630
!              WSo_LPOPMANin = WSo_LPOPMANin + So_LPOPMANin(i,j)    !BK20240630
!              WSo_PO4fxin = WSo_PO4fxin + So_PO4fxin(i,j)    !BK20240630
!              
!              WAq_LDOPaqso0 =  WAq_LDOPaqso0 + Aq_LDOPaqso0(i,j)
!              WAq_RDOPaqso0 = WAq_RDOPaqso0 + Aq_RDOPaqso0(i,j)
!              WAq_PO4aqso0 = WAq_PO4aqso0 + Aq_PO4aqso0(i,j)
!              WSo_LPOPsurf = WSo_LPOPsurf + So_LPOPsurf(i,j)
!              WSo_RPOPsurf = WSo_RPOPsurf + So_RPOPsurf(i,j)
!              WSo_MBMPsurf = WSo_MBMPsurf + So_MBMPsurf(i,j)
!              WSo_LDOPsurf = WSo_LDOPsurf + So_LDOPsurf(i,j)
!              WSo_RDOPsurf = WSo_RDOPsurf + So_RDOPsurf(i,j)
!              WSo_PO4surf =  WSo_PO4surf + So_PO4surf(i,j)
!              WSo_PIPAsurf =  WSo_PIPAsurf + So_PIPAsurf(i,j)
!              WSo_PIPSsurf =  WSo_PIPSsurf + So_PIPSsurf(i,j)
!              WSo_LDOPsoaq = WSo_LDOPsoaq + So_LDOPsoaq(i,j)
!              WSo_RDOPsoaq = WSo_RDOPsoaq + So_RDOPsoaq(i,j)
!              WSo_PO4soaq = WSo_PO4soaq + So_PO4soaq(i,j)
!              WSo_LPOPLIT = WSo_LPOPLIT + So_LPOPLIT(i,j)
!              WSo_LPOPEXC = WSo_LPOPEXC + So_LPOPEXC(i,j)
!              WSo_LPOPMAN = WSo_LPOPMAN + So_LPOPMAN(i,j)
!
!              DO isl = 1, domain%nsl
!                 WSo_LPOPRES = WSo_LPOPRES + So_LPOPRES(i,j,isl)
!                 WSo_LDOPintf = WSo_LDOPintf + So_LDOPintf(i,j,isl)
!                 WSo_RDOPintf = WSo_RDOPintf + So_RDOPintf(i,j,isl)
!                 WSo_PO4intf = WSo_PO4intf + So_PO4intf(i,j,isl)
!                 WSo_PO4uptk = WSo_PO4uptk + So_PO4uptk(i,j,isl)
!                 WSo_RPOP = WSo_RPOP + So_RPOP(i,j,isl)
!                 WSo_LDOP = WSo_LDOP + So_LDOP(i,j,isl)
!                 WSo_RDOP = WSo_RDOP + So_RDOP(i,j,isl)
!                 WSo_MBMP = WSo_MBMP + So_MBMP(i,j,isl)
!                 WSo_PO4 = WSo_PO4 + So_PO4(i,j,isl)
!                 WSo_PIPA = WSo_PIPA + So_PIPA(i,j,isl)
!                 WSo_PIPS = WSo_PIPS + So_PIPS(i,j,isl)
!                 WSo_PSC = WSo_PSC + So_PSC(i,j,isl)
!                 WSo_PMBError = WSo_PMBError + So_PMBError(i,j,isl)  !BK20240502
!              END DO
!           endif    !Y.Kwon
!        END DO
!     END DO
!
!     IF (itime .eq. 1) THEN
!        filename = trim(outdir)//'/'//'WSo_P.csv'  !BK20240102
!        open (693011, file=filename, status='unknown')
!        write (693011, *) 'YYYY-MM-DD-hh:mm:ss',',','LPOPLITin',',','LPOPRESin',',',&
!                'LPOPEXCin',',','LPOPMANin',',','PO4in',',','LDOPaqso0',',',&
!                'RDOPaqso0',',','PO4aqso0',',','LPOPsurf',',','RPOPsurf',',','MBMPsurf',',',&
!                'LDOPsurf',',','RDOPsurf',',','PO4surf',',','PIPAsurf',',','PIPSsurf',',',&
!                'LDOPintf',',','RDOPintf',',','PO4intf',',','LDOPsoaq',',','RDOPsoaq',',',&
!                'PO4soaq',',','PO4uptk',',','LPOPLIT',',','LPOPRES',',','LPOPEXC',',','LPOPMAN',',',&
!                'RPOP',',','LDOP',',','RDOP',',','MBMP',',','PO4',',','PIPA',',','PIPS',',',&
!                'PSC',',','PMBError (kg)'  !BK20240502
!     END IF
!
!     write (693011, *) dateSedCNP%olddate,',',WSo_LPOPLITin,',',WSo_LPOPRESin,',',&
!             WSo_LPOPEXCin,',',WSo_LPOPMANin,',',WSo_PO4fxin,',',WAq_LDOPaqso0,',',&
!             WAq_RDOPaqso0,',',WAq_PO4aqso0,',',WSo_LPOPsurf,',',WSo_RPOPsurf,',',&
